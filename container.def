Bootstrap: docker
From: python:3.13-slim

%files
    pyproject.toml /build/project/pyproject.toml
    libs/symbolic /build/project/libs/symbolic
    models/manifest /build/project/models/manifest
    README.md /build/project/README.md

%post
    apt-get update && apt-get install -y --no-install-recommends git ca-certificates tmux && rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir uv

    cd /build/project
    export UV_PROJECT_ENVIRONMENT=/opt/venv
    export UV_PYTHON_PREFERENCE=only-system
    uv sync --no-dev --no-editable
    rm -rf /root/.cache /build

%runscript
    exec "$@"

%environment
    export PATH=/opt/venv/bin:$PATH
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PYTHONPATH=/work/libs/symbolic/src:/work/models/manifest/src
